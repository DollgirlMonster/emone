+++ b/tests/TinyTitan/Kernels/Attention/AttentionDecodeGQATests.swift
@@ -0,0 +1,121 @@
+import Metal
+import Testing
+import TinyTitanValidationSupport
+
+@testable import TinyTitan
+
+/// attention_decode_partial_simd_gqa (one threadgroup per KV head and chunk)
+/// against attention_decode_partial_simd (one per Q head and chunk) on the
+/// long-context dense path, `TINYTITAN_ATTN_DECODE_LONG`. Per head the two run
+/// the same expressions in the same order, so the outputs must be
+/// byte-identical, not merely close. Qwen 3.6 35B-A3B's full-attention
+/// geometry: 16 Q heads, 2 KV heads (8 per group), head_dim 256.
+@Suite(.serialized) struct AttentionDecodeGQATests {
+
+    private static func run(seqLen: Int, precision: KVCachePrecision, seed: UInt64)
+        throws -> (gqa: [Float], perHead: [Float], reference: [Float])
+    {
+        let config = ArchConfig.qwen36_35B_A3B
+        let headDim = config.fullHeadDim
+        let numQHeads = config.numHeads
+        let numKVHeads = config.numFullKVHeads
+        let qCount = numQHeads * headDim
+        let rowElements = numKVHeads * headDim
+        let kvCount = seqLen * rowElements
+        var rng = SeedTree(seed).key("decode-gqa-\(seqLen)-\(precision.rawValue)")
+        let q = (0..<qCount).map { _ in Float16(rng.uniform(-0.5, 0.5)) }
+        let k = (0..<kvCount).map { _ in Float16(rng.uniform(-0.5, 0.5)) }
+        let v = (0..<kvCount).map { _ in Float16(rng.uniform(0.0, 1.0)) }
+
+        let context = try MetalContext()
+        let cache = try KVCacheManager(
+            device: context.device, config: config,
+            maxContext: seqLen, precision: precision)
+        let quantizer = try KVCacheQuantizer(context: context)
+        let attention = try Attention(context: context)
+        attention.longDecodeOverride = true
+        attention.simdPartialOverride = true
+        guard let qBuffer = Fp16Buffer.make(context.device, halves: q),
+            let kBuffer = Fp16Buffer.make(context.device, halves: k),
+            let vBuffer = Fp16Buffer.make(context.device, halves: v),
+            let outGQA = Fp16Buffer.make(context.device, count: qCount),
+            let outPerHead = Fp16Buffer.make(context.device, count: qCount)
+        else {
+            throw MetalError.bufferAllocationFailed("test buffers")
+        }
+        let layer = try #require(config.fullAttentionLayerMask.firstIndex(of: 1))
+        let keyView = cache.keyView(layer: layer, validTokenCount: seqLen)
+        let valueView = cache.valueView(layer: layer, validTokenCount: seqLen)
+        print("DBG view layer=\(layer) prec=\(keyView.precision) stride=\(keyView.stride) vb=\(keyView.valueBytes) gs=\(keyView.groupSize) kb=\(keyView.buffer.length) off=\(keyView.offset)")
+        guard let fill = context.queue.makeCommandBuffer() else {
+            throw MetalError.commandEncoderFailed
+        }
+        try quantizer.encode(
+            commandBuffer: fill, source: kBuffer,
+            sourceTokenStrideElements: rowElements,
+            destination: keyView, tokenCount: seqLen,
+            elementCount: rowElements)
+        try quantizer.encode(
+            commandBuffer: fill, source: vBuffer,
+            sourceTokenStrideElements: rowElements,
+            destination: valueView, tokenCount: seqLen,
+            elementCount: rowElements)
+        fill.commit()
+        fill.waitUntilCompleted()
+
+        for (useGQA, out) in [(true, outGQA), (false, outPerHead)] {
+            attention.gqaPartialOverride = useGQA
+            for pass in 0..<2 {
+                guard let cb = context.queue.makeCommandBuffer() else {
+                    throw MetalError.commandEncoderFailed
+                }
+                let reps = pass == 0 ? 1 : 10
+                for _ in 0..<reps {
+                    try attention.encodeFull(
+                        commandBuffer: cb, q: qBuffer,
+                        k: keyView.buffer, v: valueView.buffer,
+                        out: out,
+                        headDim: UInt32(headDim),
+                        numQHeads: UInt32(numQHeads),
+                        numKVHeads: UInt32(numKVHeads),
+                        seqLen: UInt32(seqLen),
+                        kvFormat: keyView)
+                }
+                cb.commit()
+                cb.waitUntilCompleted()
+                #expect(cb.error == nil)
+                if pass == 1 {
+                    let us = (cb.gpuEndTime - cb.gpuStartTime) * 1_000_000 / Double(reps)
+                    print(
+                        "decode_gqa_timing seqLen=\(seqLen) kv=\(precision.label) gqa=\(useGQA) per_call_us=\(Int(us))"
+                    )
+                }
+            }
+        }
+
+        let reference = AttentionRef.apply(
+            q: q.map(Float.init), k: k.map(Float.init), v: v.map(Float.init),
+            headDim: headDim, numQHeads: numQHeads,
+            numKVHeads: numKVHeads, seqLen: seqLen)
+        return (
+            Fp16Buffer.read(outGQA, count: qCount),
+            Fp16Buffer.read(outPerHead, count: qCount),
+            reference
+        )
+    }
+
+    @Test(arguments: [KVCachePrecision.int8, .int4])
+    func gqaMatchesPerHeadExactly(precision: KVCachePrecision) throws {
+        // 8,000 keys: past the 4,096 threshold, 8 chunks of 1,000.
+        let r = try Self.run(seqLen: 8_000, precision: precision, seed: 0x6A0A)
+        let rel = RelError.compute(actual: r.gqa, reference: r.reference)

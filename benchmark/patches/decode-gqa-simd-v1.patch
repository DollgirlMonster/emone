+            let p = Array(r.perHead[(h * 256)..<(h * 256 + 256)])
+            print("DBG head=\(h) nan=\(s.filter { $0.isNaN }.count) g0=\(s[0]) p0=\(p[0]) g255=\(s[255]) p255=\(p[255])")
+        }
+        #expect(r.gqa == r.perHead, "gqa differs from the per-head simd kernel")
+        #expect(rel < 0.02, "gqa vs reference rel=\(rel)")
+        #expect(!r.gqa.contains { $0.isNaN }, "NaN in gqa output")
+    }

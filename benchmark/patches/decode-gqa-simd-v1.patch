+
+// ============================================================================
+// Split-KV pass 1, simdgroup-per-key, one threadgroup per (KV head, chunk)
+// (attention_decode_partial_simd_gqa).
+//
+// attention_decode_partial_simd runs one threadgroup per (Q head, chunk), so
+// the G = num_q_heads / num_kv_heads query heads of a KV head each load and
+// dequantize the same K and V rows: 8x on Qwen 3.6 (16 Q heads, 2 KV heads).
+// Here a simdgroup loads a key's K and V once and applies them to all G heads.
+// Per head, every value goes through the same expressions in the same order as
+// attention_decode_partial_simd -- the same key interleave across simdgroups,
+// the same simd_sum, the same merge -- so its partials are meant to be
+// byte-identical, and attention_decode_combine is unchanged. The merge runs
+// one head at a time through the single-head o_sg buffer, keeping threadgroup
+// memory at the simd kernel's 8 KB. Requires head_dim % 32 == 0,
+// head_dim <= 256 and G <= kAttnGQAMaxG.
+// ============================================================================
+constant constexpr uint kAttnGQAMaxG = 8u;
+
+[[kernel, max_total_threads_per_threadgroup(kAttnThreads)]]
+void attention_decode_partial_simd_gqa(
+    device const half*  Q             [[buffer(0)]],
+    device const uchar* K             [[buffer(1)]],
+    device const uchar* V             [[buffer(2)]],
+    device       float* m_out         [[buffer(3)]],
+    device       float* d_out         [[buffer(4)]],
+    device       float* o_out         [[buffer(5)]],
+    constant     uint&  head_dim      [[buffer(6)]],
+    constant     uint&  num_q_heads   [[buffer(7)]],
+    constant     uint&  num_kv_heads  [[buffer(8)]],
+    constant     uint&  seq_len       [[buffer(9)]],
+    constant     uint&  kv_start      [[buffer(10)]],
+    constant     uint&  chunk_len     [[buffer(11)]],
+    constant     uint&  num_chunks    [[buffer(12)]],
+    constant     float& scale         [[buffer(13)]],
+    constant     uint&  kv_bits       [[buffer(14)]],
+    constant     uint&  kv_stride     [[buffer(15)]],
+    constant     uint&  kv_value_bytes [[buffer(16)]],
+    constant     uint&  kv_group_size [[buffer(17)]],
+    device const uchar* keep          [[buffer(18)]],
+    constant     uint&  use_keep      [[buffer(19)]],
+    uint tg_id           [[threadgroup_position_in_grid]],
+    uint lid             [[thread_position_in_threadgroup]],
+    uint lsize           [[threads_per_threadgroup]],
+    uint lane            [[thread_index_in_simdgroup]],
+    uint sg              [[simdgroup_index_in_threadgroup]],
+    uint simdgroups      [[simdgroups_per_threadgroup]]
+) {
+    threadgroup float m_sg[kAttnMaxSimdGroups * kAttnGQAMaxG];
+    threadgroup float d_sg[kAttnMaxSimdGroups * kAttnGQAMaxG];
+    threadgroup float o_sg[kAttnMaxSimdGroups * kAttnSimdMaxHeadDim];
+    const uint HD = attn_fc_head_dim(head_dim);
+    const uint NQ = attn_fc_num_q_heads(num_q_heads);
+    const uint NKV = attn_fc_num_kv_heads(num_kv_heads);
+    const uint NC = attn_fc_num_chunks(num_chunks);
+    const uint G = NQ / NKV;
+    const uint kv_head = tg_id / NC;
+    const uint chunk  = tg_id % NC;
+    const uint p_start = kv_start + chunk * chunk_len;
+    uint p_end = p_start + chunk_len;
+    if (p_end > seq_len) { p_end = seq_len; }
+    const uint dpl = HD / 32u;
+    const uint d0 = lane * dpl;
+    // Q is FP16 in memory, so holding it as half is exact and halves the
+    // registers the G heads need.
+    half q_reg[kAttnGQAMaxG][kAttnSimdMaxDimsPerLane];
+    float o_reg[kAttnGQAMaxG][kAttnSimdMaxDimsPerLane];
+    float m_run[kAttnGQAMaxG];
+    float d_run[kAttnGQAMaxG];
+    #pragma unroll
+    for (uint g = 0; g < kAttnGQAMaxG; ++g) {
+        device const half* Q_row = Q + (kv_head * G + g) * HD;
+        for (uint j = 0; j < kAttnSimdMaxDimsPerLane; ++j) {
+            q_reg[g][j] = (g < G && j < dpl) ? Q_row[d0 + j] : 0.0h;
+            o_reg[g][j] = 0.0f;
+        }
+        m_run[g] = -INFINITY;
+        d_run[g] = 0.0f;
+    }
+    const uint row_elems = NKV * HD;
+    const uint flat0 = kv_head * HD + d0;
+    const float sc = attn_fc_scale(scale);
+    const bool fast8 = (kv_bits == 8u) && (kv_group_size % dpl == 0u);
+    const uint groups = (row_elems + kv_group_size - 1u) / kv_group_size;
+    const uint grp = flat0 / kv_group_size;
+    for (uint p = p_start + sg; p < p_end; p += simdgroups) {
+        if (use_keep != 0u && keep[p] == 0u) { continue; }
+        const uint phys_p = attn_ring_slot(p);
+        float kval[kAttnSimdMaxDimsPerLane];
+        float vval[kAttnSimdMaxDimsPerLane];
+        if (fast8) {
+            device const uchar* krow = K + phys_p * kv_stride;
+            device const half* ks = reinterpret_cast<device const half*>(krow + kv_value_bytes);
+            const float kscale = float(ks[grp]);
+            const float kbias = float(ks[groups + grp]);
+            device const uchar* vrow = V + phys_p * kv_stride;
+            device const half* vs = reinterpret_cast<device const half*>(vrow + kv_value_bytes);
+            const float vscale = float(vs[grp]);
+            const float vbias = float(vs[groups + grp]);
+            for (uint j = 0; j < kAttnSimdMaxDimsPerLane; ++j) {
+                kval[j] = (j < dpl) ? float(krow[flat0 + j]) * kscale + kbias : 0.0f;
+                vval[j] = (j < dpl) ? float(vrow[flat0 + j]) * vscale + vbias : 0.0f;
+            }
+        } else {
+            for (uint j = 0; j < kAttnSimdMaxDimsPerLane; ++j) {
+                kval[j] = (j < dpl)
+                    ? attn_load_kv(K, phys_p, flat0 + j, row_elems, kv_bits, kv_stride,
+                                   kv_value_bytes, kv_group_size)
+                    : 0.0f;
+                vval[j] = (j < dpl)
+                    ? attn_load_kv(V, phys_p, flat0 + j, row_elems, kv_bits, kv_stride,
+                                   kv_value_bytes, kv_group_size)
+                    : 0.0f;
+            }
+        }
+        // Constant bounds, fully unrolled: a runtime bound would index the
+        // [g][j] register arrays dynamically and spill them to memory.
+        #pragma unroll
+        for (uint g = 0; g < kAttnGQAMaxG; ++g) {
+            if (g >= G) continue;
+            float partial = 0.0f;
+            for (uint j = 0; j < kAttnSimdMaxDimsPerLane; ++j) {
+                if (j < dpl) partial = fma(float(q_reg[g][j]), kval[j], partial);
+            }
+            const float s = simd_sum(partial) * sc;
+            const float m_new = max(m_run[g], s);
+            const float alpha = attn_softmax_exp(m_run[g] - m_new);
+            const float p_exp = attn_softmax_exp(s - m_new);
+            d_run[g] = d_run[g] * alpha + p_exp;
+            for (uint j = 0; j < kAttnSimdMaxDimsPerLane; ++j) {
+                if (j < dpl) o_reg[g][j] = o_reg[g][j] * alpha + p_exp * vval[j];
+            }
+            m_run[g] = m_new;
+        }
+    }
+    if (lane == 0) {
+        #pragma unroll
+        for (uint g = 0; g < kAttnGQAMaxG; ++g) {
+            if (g < G) {
+                m_sg[sg * kAttnGQAMaxG + g] = m_run[g];
+                d_sg[sg * kAttnGQAMaxG + g] = d_run[g];
+            }
+        }
+    }
+    // One head at a time through o_sg; every simdgroup reaches both barriers.
+    #pragma unroll
+    for (uint g = 0; g < kAttnGQAMaxG; ++g) {
+        if (g >= G) continue;
+        for (uint j = 0; j < kAttnSimdMaxDimsPerLane; ++j) {
+            if (j < dpl) o_sg[sg * HD + d0 + j] = o_reg[g][j];
+        }
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+        if (sg == 0) {
+            float m_g = -INFINITY;
+            for (uint c = 0; c < simdgroups; ++c) m_g = max(m_g, m_sg[c * kAttnGQAMaxG + g]);
+            const uint base = (kv_head * G + g) * NC + chunk;
+            device float* o_row = o_out + base * HD;
+            if (m_g == -INFINITY) {
+                if (lane == 0) { m_out[base] = -INFINITY; d_out[base] = 0.0f; }
+                for (uint j = 0; j < kAttnSimdMaxDimsPerLane; ++j) {
+                    if (j < dpl) o_row[d0 + j] = 0.0f;
+                }
+            } else {
+                float d_g = 0.0f;
+                float w[kAttnMaxSimdGroups];
+                for (uint c = 0; c < kAttnMaxSimdGroups; ++c) {
+                    const float mc = (c < simdgroups) ? m_sg[c * kAttnGQAMaxG + g] : -INFINITY;
+                    w[c] = (c < simdgroups && mc != -INFINITY) ? attn_softmax_exp(mc - m_g) : 0.0f;
+                    if (c < simdgroups) d_g += d_sg[c * kAttnGQAMaxG + g] * w[c];
+                }
+                for (uint j = 0; j < kAttnSimdMaxDimsPerLane; ++j) {
+                    if (j < dpl) {
+                        float acc = 0.0f;
+                        for (uint c = 0; c < simdgroups; ++c) acc += o_sg[c * HD + d0 + j] * w[c];
+                        o_row[d0 + j] = acc;
+                    }
+                }
+                if (lane == 0) { m_out[base] = m_g; d_out[base] = d_g; }
+            }
+        }
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+    }
+}

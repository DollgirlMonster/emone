+// ----------------------------------------------------------------------------
+// Chunked gated delta rule (prefill, opt-in TINYTITAN_GDN_CHUNKED=1).
+//
+// The same recurrence as gdn_delta_step_prefill, reorganised the way the
+// 2026 kernels (fla / SGLang / llama.cpp) do it: split the rows into chunks of
+// L = 64 and turn most of the work into dense products. Within a chunk, with
+// S0 the state entering it and lg_i = sum_{j<=i} log g_j (so Gamma_i = exp(lg_i)):
+//
+//   u'_i = beta_i (v_i - Gamma_i S0 k_i - sum_{j<i} (Gamma_i/Gamma_j)(k_i.k_j) u'_j)
+//   y_i  = Gamma_i S0 q_i + sum_{j<=i} (Gamma_i/Gamma_j)(q_i.k_j) u'_j
+//   S_L  = Gamma_L S0 + sum_i (Gamma_L/Gamma_i) u'_i k_i^T
+//
+// The first line is (I + A) U' = diag(beta) V - diag(beta Gamma) K S0^T with
+// A_ij = beta_i (Gamma_i/Gamma_j) k_i.k_j strictly lower. With T = (I + A)^-1:
+//   U' = Ub - W S0^T,  Ub = T diag(beta) V,  W = T diag(beta Gamma) K.
+// Ub, W and P_ij = (Gamma_i/Gamma_j) q_i.k_j (j <= i) do not depend on S0, so
+// gdn_chunk_prep computes them for every (head, chunk) at once; gdn_chunk_apply
+// then walks the chunks in order, and its per-chunk work is products against
+// S0 instead of 64 dependent steps. Decay ratios are exp of log differences,
+// never a product divided by a product, so nothing underflows.
+//
+// Rows past the end of the span are padded with beta = 0 and log g = 0: they
+// add nothing to U', P or the state, and lg_63 is the last real row's.
+// ----------------------------------------------------------------------------
+constant constexpr uint kGdnChunkL = 64;
+
+kernel void gdn_chunk_prep(
+    device const half*   conv_out [[buffer(0)]],   // [T, C]
+    device const half*   a_proj   [[buffer(1)]],   // [T, Hv]
+    device const half*   b_proj   [[buffer(2)]],   // [T, Hv]
+    device const bfloat* A_log    [[buffer(3)]],   // [Hv]
+    device const bfloat* dt_bias  [[buffer(4)]],   // [Hv]
+    device float*        W        [[buffer(5)]],   // [Hv, nC, L, Dk]
+    device float*        Ub       [[buffer(6)]],   // [Hv, nC, L, Dv]
+    device float*        P        [[buffer(7)]],   // [Hv, nC, L, L]
+    device float*        LG       [[buffer(8)]],   // [Hv, nC, L]
+    constant uint&       kHeads   [[buffer(9)]],
+    constant uint&       vHeads   [[buffer(10)]],
+    constant uint&       keyDim   [[buffer(11)]],
+    constant uint&       valueDim [[buffer(12)]],
+    constant uint&       rows     [[buffer(13)]],
+    constant uint&       rowStride [[buffer(14)]],
+    constant uint&       nChunks  [[buffer(15)]],
+    uint2 tg [[threadgroup_position_in_grid]],
+    uint2 tpos [[thread_position_in_threadgroup]],
+    uint2 tsize [[threads_per_threadgroup]]
+) {
+    const uint tid = tpos.x;
+    const uint tcount = tsize.x;
+    const uint L = kGdnChunkL;
+    const uint Hk = kHeads, Hv = vHeads, Dk = keyDim, Dv = valueDim;
+    const uint C = rowStride;
+    const uint h = tg.x;
+    const uint c = tg.y;
+    if (h >= Hv || c >= nChunks) return;
+    const uint hk = h / (Hv / Hk);
+    const uint r0 = c * L;
+    const uint n = min(L, rows - r0);
+    const uint hc = h * nChunks + c;
+
+    threadgroup float lg[kGdnChunkL];
+    threadgroup float beta[kGdnChunkL];
+    threadgroup float T[kGdnChunkL * kGdnChunkL];
+
+    // Gates, then the inclusive prefix sum of log g.
+    if (tid < L) {
+        float logg = 0.0f, bt = 0.0f;
+        if (tid < n) {
+            const uint r = r0 + tid;
+            logg = -exp(float(A_log[h]))
+                * gdn_softplus(float(a_proj[r * Hv + h]) + float(dt_bias[h]));
+            bt = 1.0f / (1.0f + exp(-float(b_proj[r * Hv + h])));
+        }
+        lg[tid] = logg;
+        beta[tid] = bt;
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    if (tid == 0) {
+        float acc = 0.0f;
+        for (uint i = 0; i < L; ++i) { acc += lg[i]; lg[i] = acc; }
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    if (tid < L) LG[hc * L + tid] = lg[tid];
+
+    // A (strictly lower), stored in T.
+    for (uint idx = tid; idx < L * L; idx += tcount) {
+        const uint i = idx / L, j = idx % L;
+        float a = 0.0f;
+        if (j < i && i < n) {
+            device const half* ki = conv_out + (r0 + i) * C + Hk * Dk + hk * Dk;
+            device const half* kj = conv_out + (r0 + j) * C + Hk * Dk + hk * Dk;
+            float dot = 0.0f;
+            for (uint k = 0; k < Dk; ++k) dot = fma(float(ki[k]), float(kj[k]), dot);
+            a = beta[i] * exp(lg[i] - lg[j]) * dot;
+        }
+        T[idx] = a;
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+
+    // T = (I + A)^-1 by forward substitution, in place, unit diagonal implied:
+    // T[i][c] = -A[i][c] - sum_{c<j<i} A[i][j] T[j][c].
+    for (uint i = 1; i < L; ++i) {
+        float t = 0.0f;
+        if (tid < i) {
+            t = -T[i * L + tid];
+            for (uint j = tid + 1; j < i; ++j) t = fma(-T[i * L + j], T[j * L + tid], t);
+        }
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+        if (tid < i) T[i * L + tid] = t;
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+    }
+
+    // W = T diag(beta Gamma) K and Ub = T diag(beta) V (T lower, unit diagonal).
+    for (uint idx = tid; idx < L * Dk; idx += tcount) {
+        const uint i = idx / Dk, k = idx % Dk;
+        float acc = 0.0f;
+        if (i < n) {
+            for (uint j = 0; j <= i; ++j) {
+                const float tij = (j == i) ? 1.0f : T[i * L + j];
+                const float kv = float(conv_out[(r0 + j) * C + Hk * Dk + hk * Dk + k]);
+                acc = fma(tij * beta[j] * exp(lg[j]), kv, acc);
+            }
+        }
+        W[(hc * L + i) * Dk + k] = acc;
+    }
+    for (uint idx = tid; idx < L * Dv; idx += tcount) {
+        const uint i = idx / Dv, d = idx % Dv;
+        float acc = 0.0f;
+        if (i < n) {
+            for (uint j = 0; j <= i; ++j) {
+                const float tij = (j == i) ? 1.0f : T[i * L + j];
+                const float vv = float(conv_out[(r0 + j) * C + 2u * Hk * Dk + h * Dv + d]);
+                acc = fma(tij * beta[j], vv, acc);
+            }
+        }
+        Ub[(hc * L + i) * Dv + d] = acc;
+    }
+    // P_ij = (Gamma_i/Gamma_j) q_i.k_j for j <= i.
+    for (uint idx = tid; idx < L * L; idx += tcount) {
+        const uint i = idx / L, j = idx % L;
+        float pv = 0.0f;
+        if (j <= i && i < n) {
+            device const half* qi = conv_out + (r0 + i) * C + hk * Dk;
+            device const half* kj = conv_out + (r0 + j) * C + Hk * Dk + hk * Dk;
+            float dot = 0.0f;
+            for (uint k = 0; k < Dk; ++k) dot = fma(float(qi[k]), float(kj[k]), dot);
+            pv = exp(lg[i] - lg[j]) * dot;
+        }
+        P[hc * L * L + idx] = pv;
+    }
+}
+
+// One threadgroup per (value head, 32 state rows); 256 threads, eight per
+// state row, each owning Dk/8 (<= 16) of that row's columns in registers.
+// Walks the window's chunks in order: U' = Ub - W S0^T, y, then the state.
+kernel void gdn_chunk_apply(
+    device const half*   conv_out [[buffer(0)]],   // [T, C]
+    device const float*  W        [[buffer(1)]],
+    device const float*  Ub       [[buffer(2)]],
+    device const float*  P        [[buffer(3)]],
+    device const float*  LG       [[buffer(4)]],
+    device float*        state    [[buffer(5)]],   // [Hv, Dv, Dk]
+    device half*         y        [[buffer(6)]],   // [T, Hv * Dv]
+    constant uint&       kHeads   [[buffer(7)]],
+    constant uint&       vHeads   [[buffer(8)]],
+    constant uint&       keyDim   [[buffer(9)]],
+    constant uint&       valueDim [[buffer(10)]],
+    constant uint&       rows     [[buffer(11)]],
+    constant uint&       rowStride [[buffer(12)]],
+    constant uint&       nChunks  [[buffer(13)]],
+    uint2 tg [[threadgroup_position_in_grid]],
+    uint2 tpos [[thread_position_in_threadgroup]]
+) {
+    const uint tid = tpos.x;
+    const uint L = kGdnChunkL;
+    const uint DT = 32;
+    const uint Hk = kHeads, Hv = vHeads, Dk = keyDim, Dv = valueDim;
+    const uint C = rowStride;
+    const uint h = tg.x;
+    const uint dvBase = tg.y * DT;
+    if (h >= Hv || dvBase >= Dv) return;
+    const uint hk = h / (Hv / Hk);
+    const uint dvl = tid / 8u;           // state row within the tile
+    const uint ks = tid % 8u;            // column slice
+    const uint nk = Dk / 8u;
+    const uint dv = dvBase + dvl;
+    const uint k0 = ks * nk;
+
+    threadgroup float Up[kGdnChunkL * 32];
+    threadgroup float QS[kGdnChunkL * 32];
+
+    float s[16];
+    device float* srow = state + (h * Dv + dv) * Dk + k0;
+    for (uint j = 0; j < nk; ++j) s[j] = srow[j];
+
+    for (uint c = 0; c < nChunks; ++c) {
+        const uint r0 = c * L;
+        const uint n = min(L, rows - r0);
+        const uint hc = h * nChunks + c;
+
+        // U'[i] = Ub[i] - W[i].S0[dv], QS[i] = q_i.S0[dv] (both before the update).
+        for (uint i = 0; i < L; ++i) {
+            device const float* wi = W + (hc * L + i) * Dk + k0;
+            float ws = 0.0f, qs = 0.0f;
+            for (uint j = 0; j < nk; ++j) ws = fma(wi[j], s[j], ws);
+            if (i < n) {
+                device const half* qi = conv_out + (r0 + i) * C + hk * Dk + k0;
+                for (uint j = 0; j < nk; ++j) qs = fma(float(qi[j]), s[j], qs);
+            }
+            ws += simd_shuffle_xor(ws, 1); ws += simd_shuffle_xor(ws, 2); ws += simd_shuffle_xor(ws, 4);
+            qs += simd_shuffle_xor(qs, 1); qs += simd_shuffle_xor(qs, 2); qs += simd_shuffle_xor(qs, 4);
+            if (ks == 0) {
+                Up[i * DT + dvl] = Ub[(hc * L + i) * Dv + dv] - ws;
+                QS[i * DT + dvl] = qs;
+            }
+        }
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+
+        device const float* lgc = LG + hc * L;
+        for (uint idx = tid; idx < L * DT; idx += 256u) {
+            const uint i = idx / DT, d = idx % DT;
+            if (i >= n) continue;
+            device const float* pi = P + hc * L * L + i * L;
+            float acc = exp(lgc[i]) * QS[i * DT + d];
+            for (uint j = 0; j <= i; ++j) acc = fma(pi[j], Up[j * DT + d], acc);
+            y[(r0 + i) * Hv * Dv + h * Dv + dvBase + d] = half(acc);
+        }
+
+        const float lgL = lgc[L - 1];
+        const float decayL = exp(lgL);
+        for (uint j = 0; j < nk; ++j) s[j] *= decayL;
+        for (uint i = 0; i < n; ++i) {
+            const float coef = exp(lgL - lgc[i]) * Up[i * DT + dvl];
+            device const half* ki = conv_out + (r0 + i) * C + Hk * Dk + hk * Dk + k0;
+            for (uint j = 0; j < nk; ++j) s[j] = fma(coef, float(ki[j]), s[j]);
+        }
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+    }
+
+    for (uint j = 0; j < nk; ++j) srow[j] = s[j];
+}
+
 // ----------------------------------------------------------------------------
 // Gated output norm: out = rmsnorm(y; weight, eps) * gate(z), per value head,
 // where gate is silu or sigmoid (FC_GDN_SIGMOID_GATE).

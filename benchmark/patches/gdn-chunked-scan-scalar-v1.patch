diff --git a/sources/TinyTitan/Metal/GDN/gdn.metal b/sources/TinyTitan/Metal/GDN/gdn.metal
index 65420c5..e498573 100644
--- a/sources/TinyTitan/Metal/GDN/gdn.metal

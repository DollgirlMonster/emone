+++ b/tests/TinyTitan/Kernels/GDN/GDNChunkedScanTests.swift
@@ -0,0 +1,133 @@
+import Foundation
+import Metal
+import Testing
+import TinyTitanValidationSupport
+
+@testable import TinyTitan
+
+/// The chunked delta-rule scan (`gdn_chunk_prep` + `gdn_chunk_apply`) against
+/// the sequential prefill kernel it replaces, on the same inputs and the same
+/// non-zero starting state. It sums in another order, so outputs agree to
+/// rounding, not bit for bit.
+@Suite struct GDNChunkedScanTests {
+
+    private struct Case {
+        let cfg: LinearAttentionConfig
+        let rows: Int
+        let windowChunks: Int
+    }
+
+    private static func readHalves(_ buffer: MTLBuffer, count: Int) -> [Float] {
+        let ptr = buffer.contents().bindMemory(to: Float16.self, capacity: count)
+        return (0..<count).map { Float(ptr[$0]) }
+    }
+
+    private static func bf16Buffer(_ device: MTLDevice, _ values: [Float]) -> MTLBuffer? {
+        let bits = values.map { UInt16(truncatingIfNeeded: $0.bitPattern >> 16) }
+        return device.makeBuffer(bytes: bits, length: bits.count * 2, options: .storageModeShared)
+    }
+
+    /// Runs one scan and returns (y, final state).
+    private static func run(
+        _ c: Case, chunked: Bool, seed: UInt64
+    ) throws -> (y: [Float], state: [Float]) {
+        let cfg = c.cfg
+        let ctx = try MetalContext()
+        let gdn = try GDN(context: ctx, config: cfg, chunkWindowChunks: c.windowChunks)
+        var rng = SeedTree(seed).key("gdn-chunked-\(c.rows)-\(cfg.keyHeadDim)")
+        let hk = cfg.numKHeads, hv = cfg.numVHeads, dk = cfg.keyHeadDim, dv = cfg.valueHeadDim
+
+        // conv_out rows as the scan sees them: unit-norm k, q scaled by
+        // 1/sqrt(Dk) (what gdn_qk_norm folds in), raw v.
+        var conv: [Float] = []
+        conv.reserveCapacity(c.rows * cfg.qkvDim)
+        for _ in 0..<c.rows {
+            var row = [Float](repeating: 0, count: cfg.qkvDim)
+            for head in 0..<hk {
+                var k = (0..<dk).map { _ in rng.uniform(-1, 1) }
+                let norm = sqrt(k.reduce(0) { $0 + $1 * $1 })
+                k = k.map { $0 / norm }
+                for i in 0..<dk {
+                    row[head * dk + i] = rng.uniform(-1, 1) / Float(dk).squareRoot()
+                    row[hk * dk + head * dk + i] = k[i]
+                }
+            }
+            for i in 0..<(hv * dv) { row[2 * hk * dk + i] = rng.uniform(-1, 1) }
+            conv += row
+        }
+        let a = (0..<(c.rows * hv)).map { _ in rng.uniform(-2, 2) }
+        let b = (0..<(c.rows * hv)).map { _ in rng.uniform(-2, 2) }
+        let aLog = (0..<hv).map { _ in rng.uniform(-1, 1) }
+        let dtBias = (0..<hv).map { _ in rng.uniform(-0.5, 0.5) }
+        let state0 = (0..<(hv * dv * dk)).map { _ in rng.uniform(-0.3, 0.3) }
+
+        guard let convBuf = Fp16Buffer.make(ctx.device, values: conv),
+            let aBuf = Fp16Buffer.make(ctx.device, values: a),
+            let bBuf = Fp16Buffer.make(ctx.device, values: b),
+            let aLogBuf = bf16Buffer(ctx.device, aLog),
+            let dtBuf = bf16Buffer(ctx.device, dtBias),
+            let stateBuf = ctx.device.makeBuffer(
+                bytes: state0, length: state0.count * 4, options: .storageModeShared),
+            let yBuf = Fp16Buffer.make(ctx.device, count: c.rows * hv * dv),
+            let checkpoint = ctx.device.makeBuffer(
+                length: state0.count * 4, options: .storageModeShared),
+            let cb = ctx.queue.makeCommandBuffer()
+        else { throw MetalError.noDevice }
+
+        if chunked {
+            try gdn.encodeDeltaStepPrefillChunked(
+                commandBuffer: cb, convOut: convBuf, aProj: aBuf, bProj: bBuf,
+                aLog: aLogBuf, aLogOffset: 0, dtBias: dtBuf, dtBiasOffset: 0,
+                state: stateBuf, y: yBuf, rows: c.rows)
+        } else {
+            // A checkpoint buffer keeps this on the sequential kernel whatever
+            // TINYTITAN_GDN_CHUNKED says; the checkpoint itself is unused.
+            try gdn.encodeDeltaStepPrefill(
+                commandBuffer: cb, convOut: convBuf, aProj: aBuf, bProj: bBuf,
+                aLog: aLogBuf, aLogOffset: 0, dtBias: dtBuf, dtBiasOffset: 0,
+                state: stateBuf, checkpointState: checkpoint, y: yBuf, rows: c.rows)
+        }
+        cb.commit()
+        cb.waitUntilCompleted()
+        #expect(cb.error == nil)
+        let state = stateBuf.contents().bindMemory(to: Float.self, capacity: state0.count)
+        return (readHalves(yBuf, count: c.rows * hv * dv), (0..<state0.count).map { state[$0] })
+    }
+
+    private static func compare(_ c: Case) throws {
+        let reference = try run(c, chunked: false, seed: 0xC0FFEE)
+        let chunked = try run(c, chunked: true, seed: 0xC0FFEE)
+        var yErr: Float = 0
+        for (got, want) in zip(chunked.y, reference.y) {
+            yErr = max(yErr, abs(got - want) / max(1, abs(want)))
+        }
+        var sErr: Float = 0
+        for (got, want) in zip(chunked.state, reference.state) {
+            sErr = max(sErr, abs(got - want) / max(1, abs(want)))
+        }
+        // Measured 6e-5 (y, one fp16 step) and 2e-7 (state) on 2026-10-01.
+        #expect(yErr <= 1e-3, "y max relative error \(yErr) (rows \(c.rows))")
+        #expect(sErr <= 1e-5, "state max relative error \(sErr) (rows \(c.rows))")
+    }
+
+    @Test func smallHeadsAcrossWindowsAndAPartialChunk() throws {
+        // 300 rows = 4 full chunks + 44, over windows of 2 chunks (3 windows).
+        try Self.compare(
+            Case(
+                cfg: LinearAttentionConfig(
+                    numKHeads: 2, numVHeads: 4, keyHeadDim: 32, valueHeadDim: 32,
+                    convKernelSize: 4),
+                rows: 300, windowChunks: 2))
+    }
+
+    @Test func fullWidthHeadsMatchTheSequentialScan() throws {
+        // The real head geometry (Dk = Dv = 128, three value heads per key
+        // head), one window, a partial last chunk.
+        try Self.compare(
+            Case(
+                cfg: LinearAttentionConfig(
+                    numKHeads: 1, numVHeads: 3, keyHeadDim: 128, valueHeadDim: 128,
+                    convKernelSize: 4),
+                rows: 200, windowChunks: 32))
+    }
+}
